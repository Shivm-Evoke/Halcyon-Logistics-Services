# Copy to server/.env (git-ignored, never committed or shipped in the Docker image) and fill in.
# Claude on Microsoft Foundry: the endpoint https://<resource>.services.ai.azure.com/anthropic/... gives the resource name.
ANTHROPIC_FOUNDRY_RESOURCE=thebugcreators-hackathon
ANTHROPIC_FOUNDRY_API_KEY=
# Your deployment's name in Foundry (Build -> Models -> Deployments).
CLAUDE_MODEL=claude-opus-5-5-fast
# Demo website accounts, created at startup. Leave a pair blank to skip that account.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
DEMO_CUSTOMER_CLIENT=C055
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
